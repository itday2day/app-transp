{
  "expo": {
    "name": "Control de Jornada",
    "slug": "control-de-jornada",
    "version": "1.0.0",
    "scheme": "apptransp",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.day2day.apptransp",
      "infoPlist": {
        "NSCameraUsageDescription": "Necesitamos acceso a la cámara para que puedas tomar la foto del tacómetro y de la ruta al iniciar o cerrar tu jornada.",
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para registrar el punto de inicio y cierre de tu jornada de trabajo."
      }
    },
    "android": {
      "package": "com.day2day.apptransp",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B5FFF"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Necesitamos tu ubicación para registrar el inicio y cierre de tu jornada."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Necesitamos este permiso para guardar en la galería de tu teléfono una copia de las fotos que tomas en la app.",
          "granularPermissions": []
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "https://tgmfopfekwlucofjlssn.supabase.co",
      "supabaseAnonKey": "sb_publishable_L7jSGgTTTQm9WfGKPRIH8Q_Rx8ZPznb",
      "eas": {
        "projectId": "3c0c2511-252f-4887-9f1b-a555de4591cb"
      }
    }
  }
}
