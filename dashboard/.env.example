# URL del proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave publicable/anon (respeta RLS). Segura para el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Clave service_role (SALTA RLS). SOLO se usa dentro de Route Handlers en el
# servidor. NUNCA debe llevar el prefijo NEXT_PUBLIC_ ni exponerse al cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Secreto para firmar la cookie de sesión de administrador (HMAC-SHA256, ver
# lib/auth.ts) — no es la contraseña de ningún admin, cada uno tiene la suya
# propia en la tabla `admins` (ver supabase/schema_v7_admins.sql). CAMBIA
# este valor en tu propio .env.local antes de desplegar — el de ejemplo NO es
# seguro.
DASHBOARD_SESSION_SECRET=cambiame-por-un-string-largo-y-aleatorio

# URL base del servidor mock (server/mock) usado para generar/enviar el
# reporte en Excel por correo.
MOCK_SERVER_URL=http://localhost:4000

# API key de Geoapify (plan gratuito, sin tarjeta) — usada por
# /api/tracking/ruta-jornada-match para ajustar el trazado histórico de
# rutas a las calles reales (Map Matching). Sin esta variable, el trazado
# cae a una línea recta entre los pings crudos en vez de romper la pantalla.
GEOAPIFY_API_KEY=tu-api-key-de-geoapify
