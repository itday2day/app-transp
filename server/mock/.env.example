# En local, sin ninguna de estas variables, el envío de correo cae
# automáticamente a una cuenta de prueba Ethereal (sin credenciales, genera
# un link de previsualización) — alcanza para desarrollo.

# API key de Resend (https://resend.com) — es el camino que usa producción,
# vía HTTPS: Render bloquea los puertos SMTP salientes en el plan free.
RESEND_API_KEY=

# Remitente verificado en Resend. Opcional: sin dominio propio verificado,
# Resend solo entrega al mismo correo con el que se creó la cuenta,
# independientemente de este valor.
RESEND_FROM_EMAIL=

# Alternativa a Resend con SMTP real — solo funciona en desarrollo local.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
